{
  "name": "remo-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:infisical": "infisical run --env=dev -- tsx server.ts",
    "start": "node dist/server.cjs",
    "start:node": "npx tsx server.ts",
    "pm2": "pm2 start ecosystem.config.cjs",
    "pm2:save": "pm2 save",
    "pm2:status": "pm2 status",
    "service:install": "node install-service.js",
    "service:uninstall": "node uninstall-service.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "vite build",
    "build:mobile": "node scripts/mobile-build.cjs",
    "build:apk": "node scripts/mobile-build.cjs && cap copy android",
    "mobile:cache-bust": "node scripts/cache-bust-mobile.cjs",
    "cap:sync": "cap sync",
    "cap:add-android": "cap add android",
    "cap:open-android": "cap open android",
    "cap:patch-android": "node scripts/patch-android.cjs",
    "cap:copy": "cap copy",
    "set-mobile-api": "node scripts/set-mobile-api-base.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "migrate": "tsx migrate-to-postgres.ts",
    "erp-migrate": "tsx scripts/erp-accounting-migration.ts",
    "desktop:build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis",
    "desktop:pack": "npm run desktop:build && electron-builder --win dir"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^1.29.0",
    "@graphland/zkteco": "^0.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "11.18.2",
    "html2pdf.js": "^0.14.0",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "11.18.2",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "pm2": "^6.0.14",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.8",
    "react-paginate": "^8.3.0",
    "recharts": "^3.9.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.1",
    "tsx": "^4.21.0",
    "vite-plugin-pwa": "^1.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.remopro.erp",
    "productName": "REMO PRO",
    "artifactName": "REMO-PRO-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/**/{test,tests,docs,examples}/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "REMO-PRO-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "REMO PRO",
      "perMachine": false
    },
    "publish": null
  }
}
