@echo off
chcp 65001 >nul
echo =================================================================
echo أداة فحص واصلاح اتصال الموبايل بالسيرفر (Network Diagnostic Tool)
echo =================================================================
echo.

:: Check for administrator rights
net session >nul 2>&1
if %errorLevel% == 0 (
    echo [OK] تم التشغيل بصلاحيات المسؤول.
) else (
    echo [ERROR] يرجى إغلاق هذه الشاشة، ثم النقر بزر الماوس الأيمن على الملف
    echo واختيار "Run as administrator" (التشغيل كمسؤول).
    pause
    exit /b 1
)

echo.
echo -----------------------------------------------------------------
echo 1. عنوان السيرفر الخاص بك (IP Address) حالياً هو:
echo -----------------------------------------------------------------
ipconfig | findstr /i "IPv4"
echo (تأكد أن هذا الرقم هو بالضبط ما تكتبه في الموبايل)
echo.

echo -----------------------------------------------------------------
echo 2. حالة جدار حماية الويندوز (Windows Firewall):
echo -----------------------------------------------------------------
echo سيتم الآن إيقاف جدار حماية الويندوز "مؤقتاً" لتجربة الاتصال...
netsh advfirewall set allprofiles state off
echo [تم إيقاف جدار الحماية]
echo.
echo *** جرب الآن الدخول من الموبايل واضغط (حفظ وإعادة التشغيل) ***
echo إذا نجح الدخول، فهذا يعني أن المشكلة كانت من جدار حماية الويندوز أو الأنتي فايروس.
echo.
pause

echo.
echo -----------------------------------------------------------------
echo إعادة تشغيل جدار الحماية...
echo -----------------------------------------------------------------
netsh advfirewall set allprofiles state on
echo [تم إعادة تشغيل جدار الحماية للحفاظ على أمان جهازك]
echo.

echo -----------------------------------------------------------------
echo إذا لم يعمل حتى بعد إيقاف جدار الحماية، فتأكد من الآتي:
echo 1. الموبايل والكمبيوتر متصلين على نفس شبكة الواي فاي.
echo 2. هل قمت بعمل Build لنسخة APK جديدة من Android Studio وتثبيتها؟
echo    (بدون تثبيت ملف APK الجديد، الموبايل لن يشعر بأي تحديث).
echo 3. هل قمت بتعطيل أي برنامج حماية (Antivirus) مثل Avast أو Kaspersky مؤقتاً؟
echo -----------------------------------------------------------------
pause
